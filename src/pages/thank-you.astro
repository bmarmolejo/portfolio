---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Thank you | Brenda Marmolejo" description="Thanks for reaching out to Brenda Marmolejo.">
  <main class="wrapper confirmation">
    <p class="eyebrow">MESSAGE RECEIVED</p>
    <h1>Thank you for reaching out<span>!</span></h1>
    <p>Your message has been submitted. I'll get back to you as soon as I can.</p>
    <a href="/">Back to home ↗</a>
  </main>
  <style>
    .confirmation { min-height: 60vh; display: flex; flex-direction: column; align-items: flex-start; justify-content: center; gap: 1.5rem; padding-block: 5rem; }
    .eyebrow { color: var(--accent-regular); font-weight: 750; letter-spacing: .15em; font-size: .8rem; }
    h1 { font-family: var(--font-brand); font-size: clamp(2.5rem, 6vw, 5rem); line-height: 1.1; max-width: 15ch; }
    h1 span { color: var(--accent-regular); }
    p:not(.eyebrow) { color: var(--gray-300); font-size: 1.2rem; }
    a { color: var(--accent-regular); font-weight: 700; }
  </style>
</BaseLayout>
