---
import BaseLayout from "../layouts/BaseLayout.astro";
import CallToAction from "../components/CallToAction.astro";
import Icon from "../components/Icon.astro";
import ContactCTA from "../components/ContactCTA.astro";

const highlights = [
  { title: 'SocialAI by Maram', label: 'AI PRODUCT · SAAS', description: 'An AI-powered social media strategy platform built to help small businesses turn ideas into content.', image: '/assets/projects/socialai.webp', url: 'https://social-ai.maramhub.com/', action: 'Explore SocialAI' },
  { title: 'Enobot', label: 'GENERATIVE AI · WINE', description: 'A wine discovery app that uses AI to predict tasting profiles from grapes, regions, and wine styles.', image: '/assets/projects/enobot.webp', url: 'https://enobot.netlify.app/', action: 'Explore Enobot' },
  { title: 'AI Lead Generation Agents', label: 'AI AUTOMATION · BUSINESS', description: 'AI-assisted prospecting tools to discover, organize, and evaluate leads and potential business partners.', image: '/assets/projects/gestoriamx-agent.webp', url: '/work/', action: 'Explore projects' },
];
---

<BaseLayout>
  <div class="home stack gap-20 lg:gap-48">
    <header class="wrapper hero">
      <div class="hero-copy">
        <p class="eyebrow"><span class="status-dot"></span> HELLO FROM TORONTO, CANADA</p>
        <h1>Hi, I'm Brenda<span class="accent">.</span></h1>
        <p class="hero-statement">Curious by nature.<br />Analytical by training.<br /><span class="accent-text">Entrepreneurial by choice.</span></p>
        <p class="hero-intro">
          I'm an engineer, technologist, and entrepreneur exploring the connections
          between AI, business, wine, and creativity. I love turning curiosity
          into ideas, and ideas into meaningful projects.
        </p>
        <div class="hero-actions">
          <CallToAction href="/work/">Explore my projects <Icon icon="arrow-right" size="1.2em" /></CallToAction>
          <a class="text-link" href="/about/">More about me <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <div class="portrait-frame">
        <img src="/assets/portrait.jpg" alt="Portrait of Brenda Marmolejo" width="480" height="620" fetchpriority="high" />
      </div>
        <div class="interest-tags" aria-label="My interests">
          <span class="tag-ai"><Icon icon="terminal-window" size="1.15em" /> AI &amp; Technology</span>
          <span class="tag-business"><Icon icon="entrepreneur" size="1.15em" /> Entrepreneurship</span>
          <span class="tag-wine"><Icon icon="wine" size="1.15em" /> Wine &amp; Culture</span>
          <span class="tag-data"><span aria-hidden="true">✳</span> Data &amp; Innovation</span>
        </div>
    </header>

    <main class="stack gap-20 lg:gap-48">
      <section class="wrapper section-intro" aria-labelledby="many-worlds">
        <div class="section-heading">
          <p class="eyebrow">WHAT MAKES ME, ME</p>
          <h2 id="many-worlds">One person. Many worlds.</h2>
          <p>My path hasn't followed a straight line, and that's exactly what I love about it. Each discipline brings a different perspective to the next.</p>
        </div>
        <div class="worlds-grid">
          <article class="world-card">
            <span class="world-number">01 / EXPLORE</span>
            <Icon icon="terminal-window" color="var(--accent-regular)" size="2.3rem" gradient />
            <h3>Technology &amp; AI</h3>
            <p>Building digital experiences, exploring AI, and using data to understand and solve real problems.</p>
          </article>
          <article class="world-card">
            <span class="world-number">02 / CREATE</span>
            <Icon icon="entrepreneur" color="var(--accent-regular)" size="2.3rem" gradient />
            <h3>Business &amp; Ideas</h3>
            <p>From e-commerce to digital ventures, I enjoy the challenge of bringing an idea to life.</p>
          </article>
          <article class="world-card">
            <span class="world-number">03 / DISCOVER</span>
            <Icon icon="wine" color="var(--accent-regular)" size="2.3rem" gradient />
            <h3>Wine &amp; Culture</h3>
            <p>Wine education, new places, shared tables, and the stories that connect people and cultures.</p>
          </article>
        </div>
      </section>

      <section class="projects-section" aria-labelledby="projects-title">
        <div class="wrapper stack gap-8">
          <div class="section-heading projects-heading">
            <div>
              <p class="eyebrow">THINGS I'VE BUILT</p>
              <h2 id="projects-title">Selected projects</h2>
              <p>A mix of experiments, software, and ideas that became something real.</p>
            </div>
            <a class="text-link" href="/work/">View all projects <span aria-hidden="true">↗</span></a>
          </div>
          <div class="highlight-grid">
            {highlights.map((project) => (
              <article class="highlight-card">
                <div class="highlight-image">
                  <img src={project.image} alt={`Preview of ${project.title}`} loading="lazy" decoding="async" width="1600" height="1050" />
                </div>
                <div class="highlight-copy">
                  <span class="highlight-label">{project.label}</span>
                  <h3>{project.title}</h3>
                  <p>{project.description}</p>
                  <a href={project.url} target={project.url.startsWith('http') ? '_blank' : undefined} rel={project.url.startsWith('http') ? 'noopener noreferrer' : undefined}>{project.action} <span aria-hidden="true">↗</span></a>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="wrapper current-work" aria-labelledby="current-work-title">
        <div class="section-heading">
          <p class="eyebrow">ON MY DESK LATELY</p>
          <h2 id="current-work-title">What I'm working on<span class="accent">.</span></h2>
          <p>A peek at the ideas and projects I'm building, developing, and refining right now.</p>
        </div>
        <div class="current-grid">
          <article class="current-card">
            <div class="current-top"><span class="project-symbol" aria-hidden="true">✳</span><span class="project-kind">AI PRODUCT</span></div>
            <h3>SocialAI by Maram</h3>
            <p>An AI-powered tool helping small businesses create social media strategies and content with less guesswork.</p>
            <a href="https://social-ai.maramhub.com/" target="_blank" rel="noopener noreferrer">Explore SocialAI <span aria-hidden="true">↗</span></a>
          </article>
          <article class="current-card">
            <div class="current-top"><span class="project-symbol" aria-hidden="true">◈</span><span class="project-kind">CONFIDENTIAL CLIENT PROJECT</span></div>
            <h3>Business Workflow Platform</h3>
            <p>A custom business application designed to bring structure and efficiency to specialized workflows. Project details are private.</p>
            <span class="private-label">Private project</span>
          </article>
          <article class="current-card">
            <div class="current-top"><span class="project-symbol" aria-hidden="true">✺</span><span class="project-kind">PERSONAL VENTURE</span></div>
            <h3>MyMazatlan</h3>
            <p>Exploring a digital destination for discovering local places, businesses, and experiences in Mazatlán, Mexico.</p>
            <a href="https://mymazatlan.com/" target="_blank" rel="noopener noreferrer">Explore MyMazatlan <span aria-hidden="true">↗</span></a>
          </article>
        </div>
      </section>
    </main>
    <ContactCTA />
  </div>

  <style>
    .home { overflow: hidden; }
    .hero { display: grid; gap: 3rem; align-items: center; padding-block: 3rem 1rem; }
    .hero-copy { min-width: 0; }
    .eyebrow { display: flex; align-items: center; gap: .7rem; color: var(--accent-regular); font-size: .75rem; font-weight: 750; letter-spacing: .16em; text-transform: uppercase; }
    .status-dot { width: .55rem; height: .55rem; border-radius: 50%; background: var(--accent-regular); box-shadow: 0 0 0 .3rem color-mix(in srgb, var(--accent-regular) 12%, transparent); }
    h1, h2, h3 { font-family: var(--font-brand); }
    h1 { font-size: clamp(3.3rem, 8vw, 6.5rem); line-height: 1.03; letter-spacing: -.055em; margin-block: 1.5rem 1rem; }
    .accent, .accent-text { color: var(--accent-regular); }
    .hero-statement { font-family: var(--font-brand); font-size: clamp(1.45rem, 3vw, 2.6rem); font-weight: 650; line-height: 1.24; letter-spacing: -.025em; }
    .hero-intro { max-width: 56ch; margin-top: 1.5rem; font-size: clamp(1rem, 1.5vw, 1.17rem); line-height: 1.75; color: var(--gray-300); }
    .interest-tags { display: flex; flex-wrap: wrap; justify-content: center; gap: .65rem; margin-top: .5rem; }
    .interest-tags > span { display: inline-flex; align-items: center; justify-content: center; gap: .45rem; white-space: nowrap; padding: .62rem .9rem; border: 1px solid #d8ccff; border-radius: 999px; background: #eae4ff; color: #5133a4; font-size: .84rem; font-weight: 650; transition: transform .2s ease, box-shadow .2s ease; }
    .interest-tags > span:hover { transform: translateY(-2px); box-shadow: var(--shadow-sm); }
    :global(.theme-dark) .interest-tags > span { background: #342653; color: #d9c8ff; border-color: #5e488b; }
    .hero-actions { display: flex; align-items: center; gap: 1.5rem; flex-wrap: wrap; margin-top: 2rem; }
    .text-link { color: var(--gray-100); text-decoration: none; font-weight: 700; }
    .text-link:hover { color: var(--accent-regular); }
    .portrait-frame { position: relative; width: 100%; max-width: 29rem; justify-self: center; }
    .portrait-frame::before { content: ""; position: absolute; inset: 7% -5% -5% 5%; border-radius: 2rem; background: var(--gradient-subtle); border: 1px solid var(--gray-800); transform: rotate(5deg); z-index: -1; }
    .portrait-frame img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: top; border-radius: 2rem; box-shadow: var(--shadow-md); }
    .section-heading { max-width: 50rem; }
    .section-heading h2 { font-size: clamp(2.4rem, 5vw, 4.5rem); line-height: 1.1; letter-spacing: -.045em; margin-block: .7rem 1rem; }
    .section-heading > p:last-child, .projects-heading > div > p:last-child { color: var(--gray-300); font-size: 1.1rem; line-height: 1.7; }
    .worlds-grid { display: grid; grid-template-columns: 1fr; gap: 1rem; margin-top: 2.5rem; }
    .world-card { display: flex; flex-direction: column; align-items: flex-start; gap: 1.1rem; padding: 2rem; border: 1px solid var(--gray-800); border-radius: 1.4rem; background: var(--gray-999_40); box-shadow: var(--shadow-sm); }
    .world-number { color: var(--gray-400); font-size: .72rem; font-weight: 700; letter-spacing: .13em; }
    .world-card h3 { font-size: 1.55rem; }
    .world-card p { color: var(--gray-300); line-height: 1.7; }
    .projects-section { padding-block: 4rem; background: var(--gradient-subtle); border-block: 1px solid var(--gray-800); }
    .projects-heading { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 1.5rem; max-width: none; }
    .projects-heading > div { max-width: 45rem; }
    .highlight-grid { display: grid; grid-template-columns: repeat(1, minmax(0, 1fr)); gap: 1.25rem; }
    .highlight-card { display: flex; flex-direction: column; min-width: 0; overflow: hidden; border: 1px solid var(--gray-800); border-radius: 1.5rem; background: var(--gray-999); }
    .highlight-image { display: block; padding: .8rem; background: var(--gray-900); }
    .highlight-image img { display: block; width: 100%; height: auto; aspect-ratio: auto; object-fit: contain; border-radius: .5rem; }
    .highlight-copy { display: flex; flex: 1; flex-direction: column; align-items: flex-start; gap: .8rem; padding: 1.5rem; }
    .highlight-label { color: var(--accent-regular); font-size: .72rem; letter-spacing: .12em; font-weight: 800; }
    .highlight-copy h3 { font-size: clamp(1.4rem, 2vw, 1.85rem); }
    .highlight-copy p { color: var(--gray-300); line-height: 1.65; flex: 1; }
    .highlight-copy a { color: var(--accent-regular); text-decoration: none; font-weight: 750; }
    .highlight-copy a:hover { text-decoration: underline; }
    @media (min-width: 48em) { .highlight-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
    .current-work { display: grid; gap: 2.5rem; }
    .current-grid { display: grid; gap: 1rem; }
    .current-card { display: flex; flex-direction: column; align-items: flex-start; gap: 1.1rem; min-width: 0; padding: 2rem; border: 1px solid var(--gray-800); border-radius: 1.4rem; background: var(--gray-999_40); box-shadow: var(--shadow-sm); }
    .current-top { display: flex; width: 100%; align-items: center; justify-content: space-between; gap: .8rem; }
    .project-symbol { color: var(--accent-regular); font-size: 2.5rem; line-height: 1; }
    .project-kind { color: var(--gray-400); font-size: .68rem; font-weight: 750; letter-spacing: .08em; text-align: right; }
    .current-card h3 { font-size: 1.5rem; line-height: 1.2; }
    .current-card p { color: var(--gray-300); line-height: 1.7; flex: 1; }
    .current-card a { color: var(--accent-regular); font-weight: 700; text-decoration: none; }
    .current-card a:hover { text-decoration: underline; }
    .private-label { color: var(--gray-400); font-size: .9rem; font-weight: 650; }
    @media (min-width: 50em) {
      .hero { grid-template-columns: minmax(0, 1.2fr) minmax(0, .8fr); gap: clamp(2rem, 5vw, 5rem); padding-block: 5rem 2rem; }
      .interest-tags { grid-column: 1 / -1; flex-wrap: nowrap; justify-content: center; gap: .6rem; }
      .interest-tags > span { font-size: clamp(.72rem, 1.12vw, .9rem); padding-inline: clamp(.55rem, 1.5vw, 1.1rem); }
      .worlds-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
      .current-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    }
    @media (prefers-reduced-motion: no-preference) {
      .world-card, .current-card { transition: transform .2s ease, box-shadow .2s ease; }
      .world-card:hover, .current-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); }
    }
  </style>
</BaseLayout>
