---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import CallToAction from "../components/CallToAction.astro";
import Grid from "../components/Grid.astro";
import Icon from "../components/Icon.astro";
import PortfolioPreview from "../components/PortfolioPreview.astro";
import ContactCTA from "../components/ContactCTA.astro";

const allProjects = await getCollection("work");
const featuredNames = ["Enobot", "The Rank", "Mazatlan", "InStock"];
const projects = featuredNames
  .map((name) => allProjects.find((project) => project.data.title.toLowerCase() === name.toLowerCase()))
  .filter((project): project is (typeof allProjects)[number] => project !== undefined);
const featuredProjects = projects.length >= 3
  ? projects
  : [...allProjects].sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()).slice(0, 4);
---

<BaseLayout>
  <div class="home stack gap-20 lg:gap-48">
    <header class="wrapper hero">
      <div class="hero-copy">
        <p class="eyebrow"><span class="status-dot"></span> HELLO FROM TORONTO, CANADA</p>
        <h1>Hi, I'm Brenda<span class="accent">.</span></h1>
        <p class="hero-statement">Curious by nature.<br />Analytical by training.<br /><span class="accent-text">Entrepreneurial by choice.</span></p>
        <p class="hero-intro">
          I'm an engineer, technologist, and entrepreneur exploring the connections
          between AI, business, wine, and creativity. I love turning curiosity
          into ideas, and ideas into meaningful projects.
        </p>
        <div class="interest-tags" aria-label="My interests">
          <span>AI &amp; Technology</span>
          <span>Entrepreneurship</span>
          <span>Wine &amp; Culture</span>
          <span>Data &amp; Innovation</span>
        </div>
        <div class="hero-actions">
          <CallToAction href="/work/">Explore my projects <Icon icon="arrow-right" size="1.2em" /></CallToAction>
          <a class="text-link" href="/about/">More about me <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <div class="portrait-frame">
        <img src="/assets/portrait.jpg" alt="Portrait of Brenda Marmolejo" width="480" height="620" fetchpriority="high" />
        <span class="portrait-caption">A little bit of everything, always learning.</span>
      </div>
    </header>

    <main class="stack gap-20 lg:gap-48">
      <section class="wrapper section-intro" aria-labelledby="many-worlds">
        <div class="section-heading">
          <p class="eyebrow">WHAT MAKES ME, ME</p>
          <h2 id="many-worlds">One person. Many worlds.</h2>
          <p>My path hasn't followed a straight line, and that's exactly what I love about it. Each discipline brings a different perspective to the next.</p>
        </div>
        <div class="worlds-grid">
          <article class="world-card">
            <span class="world-number">01 / EXPLORE</span>
            <Icon icon="terminal-window" color="var(--accent-regular)" size="2.3rem" gradient />
            <h3>Technology &amp; AI</h3>
            <p>Building digital experiences, exploring AI, and using data to understand and solve real problems.</p>
          </article>
          <article class="world-card">
            <span class="world-number">02 / CREATE</span>
            <Icon icon="entrepreneur" color="var(--accent-regular)" size="2.3rem" gradient />
            <h3>Business &amp; Ideas</h3>
            <p>From e-commerce to digital ventures, I enjoy the challenge of bringing an idea to life.</p>
          </article>
          <article class="world-card">
            <span class="world-number">03 / DISCOVER</span>
            <Icon icon="wine" color="var(--accent-regular)" size="2.3rem" gradient />
            <h3>Wine &amp; Culture</h3>
            <p>Wine education, new places, shared tables, and the stories that connect people and cultures.</p>
          </article>
        </div>
      </section>

      <section class="projects-section" aria-labelledby="projects-title">
        <div class="wrapper stack gap-8">
          <div class="section-heading projects-heading">
            <div>
              <p class="eyebrow">THINGS I'VE BUILT</p>
              <h2 id="projects-title">Selected projects</h2>
              <p>A mix of experiments, software, and ideas that became something real.</p>
            </div>
            <a class="text-link" href="/work/">View all projects <span aria-hidden="true">↗</span></a>
          </div>
          <Grid variant="offset">
            {featuredProjects.map((project) => (
              <li><PortfolioPreview project={project} /></li>
            ))}
          </Grid>
        </div>
      </section>

      <section class="wrapper exploring" aria-labelledby="exploring-title">
        <div class="section-heading">
          <p class="eyebrow">ALWAYS LEARNING</p>
          <h2 id="exploring-title">Currently exploring<span class="accent">.</span></h2>
          <p>Some of the things keeping my curiosity busy lately.</p>
        </div>
        <div class="exploring-grid">
          <article class="exploring-item">
            <span class="exploring-symbol" aria-hidden="true">✳</span>
            <div><h3>Artificial intelligence</h3><p>AI agents, model evaluation, and useful applications of emerging technology.</p></div>
          </article>
          <article class="exploring-item">
            <span class="exploring-symbol" aria-hidden="true">◈</span>
            <div><h3>Data science</h3><p>Finding patterns, asking better questions, and making sense of complex information.</p></div>
          </article>
          <article class="exploring-item">
            <span class="exploring-symbol" aria-hidden="true">✺</span>
            <div><h3>Wine &amp; experiences</h3><p>Wine regions, education, and the experiences that bring people together.</p></div>
          </article>
        </div>
      </section>
    </main>
    <ContactCTA />
  </div>

  <style>
    .home { overflow: hidden; }
    .hero { display: grid; gap: 3rem; align-items: center; padding-block: 3rem 1rem; }
    .hero-copy { min-width: 0; }
    .eyebrow { display: flex; align-items: center; gap: .7rem; color: var(--accent-regular); font-size: .75rem; font-weight: 750; letter-spacing: .16em; text-transform: uppercase; }
    .status-dot { width: .55rem; height: .55rem; border-radius: 50%; background: var(--accent-regular); box-shadow: 0 0 0 .3rem color-mix(in srgb, var(--accent-regular) 12%, transparent); }
    h1, h2, h3 { font-family: var(--font-brand); }
    h1 { font-size: clamp(3.3rem, 8vw, 6.5rem); line-height: 1.03; letter-spacing: -.055em; margin-block: 1.5rem 1rem; }
    .accent, .accent-text { color: var(--accent-regular); }
    .hero-statement { font-family: var(--font-brand); font-size: clamp(1.45rem, 3vw, 2.6rem); font-weight: 650; line-height: 1.24; letter-spacing: -.025em; }
    .hero-intro { max-width: 56ch; margin-top: 1.5rem; font-size: clamp(1rem, 1.5vw, 1.17rem); line-height: 1.75; color: var(--gray-300); }
    .interest-tags { display: flex; flex-wrap: wrap; gap: .65rem; margin-top: 1.75rem; }
    .interest-tags span { padding: .48rem .82rem; border: 1px solid var(--gray-700); border-radius: 999px; color: var(--gray-200); background: var(--gray-999_40); font-size: .82rem; }
    .hero-actions { display: flex; align-items: center; gap: 1.5rem; flex-wrap: wrap; margin-top: 2rem; }
    .text-link { color: var(--gray-100); text-decoration: none; font-weight: 700; }
    .text-link:hover { color: var(--accent-regular); }
    .portrait-frame { position: relative; width: 100%; max-width: 29rem; justify-self: center; }
    .portrait-frame::before { content: ""; position: absolute; inset: 7% -5% -5% 5%; border-radius: 2rem; background: var(--gradient-subtle); border: 1px solid var(--gray-800); transform: rotate(5deg); z-index: -1; }
    .portrait-frame img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: top; border-radius: 2rem; box-shadow: var(--shadow-md); }
    .portrait-caption { position: absolute; bottom: 1.2rem; left: 1rem; right: 1rem; padding: .75rem 1rem; border-radius: .75rem; background: var(--gray-999); color: var(--gray-200); font-size: .85rem; text-align: center; box-shadow: var(--shadow-sm); }
    .section-heading { max-width: 50rem; }
    .section-heading h2 { font-size: clamp(2.4rem, 5vw, 4.5rem); line-height: 1.1; letter-spacing: -.045em; margin-block: .7rem 1rem; }
    .section-heading > p:last-child, .projects-heading > div > p:last-child { color: var(--gray-300); font-size: 1.1rem; line-height: 1.7; }
    .worlds-grid { display: grid; grid-template-columns: 1fr; gap: 1rem; margin-top: 2.5rem; }
    .world-card { display: flex; flex-direction: column; align-items: flex-start; gap: 1.1rem; padding: 2rem; border: 1px solid var(--gray-800); border-radius: 1.4rem; background: var(--gray-999_40); box-shadow: var(--shadow-sm); }
    .world-number { color: var(--gray-400); font-size: .72rem; font-weight: 700; letter-spacing: .13em; }
    .world-card h3 { font-size: 1.55rem; }
    .world-card p { color: var(--gray-300); line-height: 1.7; }
    .projects-section { padding-block: 4rem; background: var(--gradient-subtle); border-block: 1px solid var(--gray-800); }
    .projects-heading { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 1.5rem; max-width: none; }
    .projects-heading > div { max-width: 45rem; }
    .exploring { display: grid; gap: 2.5rem; }
    .exploring-grid { display: grid; gap: 1rem; }
    .exploring-item { display: flex; gap: 1.3rem; padding: 1.5rem; border: 1px solid var(--gray-800); border-radius: 1.2rem; background: var(--gray-999_40); }
    .exploring-symbol { color: var(--accent-regular); font-size: 2rem; line-height: 1; }
    .exploring-item h3 { font-size: 1.3rem; margin-bottom: .5rem; }
    .exploring-item p { color: var(--gray-300); line-height: 1.65; }
    @media (min-width: 50em) {
      .hero { grid-template-columns: minmax(0, 1.2fr) minmax(0, .8fr); gap: clamp(2rem, 5vw, 5rem); padding-block: 5rem 2rem; }
      .worlds-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
      .exploring { grid-template-columns: .85fr 1.15fr; align-items: start; gap: 4rem; }
    }
    @media (prefers-reduced-motion: no-preference) {
      .world-card, .exploring-item { transition: transform .2s ease, box-shadow .2s ease; }
      .world-card:hover, .exploring-item:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); }
    }
  </style>
</BaseLayout>
